<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#0080FE"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="350dp"
        android:layout_height="720dp"
        android:foregroundGravity="center"
        app:cardCornerRadius="20dp"
        app:cardElevation="20dp"
        android:orientation="horizontal"

        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="29dp"
        tools:layout_editor_absoluteY="124dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="320dp"
            android:layout_height="720dp">

            <TextView
                android:id="@+id/usernametext"
                android:layout_width="280dp"
                android:layout_height="0dp"
                android:text="@string/usernamestring"
                android:textSize="20sp"
                tools:layout_editor_absoluteX="38dp"
                tools:layout_editor_absoluteY="34dp"
                />

            <EditText
                android:id="@+id/etusernamelabel"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:hint="@string/fullnameinput"
                android:background="#F2F2F2"
                android:inputType="text"
                tools:layout_editor_absoluteX="38dp"
                tools:layout_editor_absoluteY="76dp" />

            <TextView
                android:id="@+id/purchasetext"
                android:layout_width="280dp"
                android:layout_height="0dp"
                android:text="@string/purchaseidtext"
                android:textSize="20sp"

                tools:layout_editor_absoluteX="42dp"
                tools:layout_editor_absoluteY="257dp" />

            <EditText
                android:id="@+id/productidlabel"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:inputType="text"
                android:hint="@string/productidlabel"
                android:background="#F2F2F2"
                tools:layout_editor_absoluteX="42dp"
                tools:layout_editor_absoluteY="303dp" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="280dp"
                android:layout_height="0dp"
                android:text="@string/textemail"
                android:textSize="20sp"
                tools:layout_editor_absoluteX="38dp"
                tools:layout_editor_absoluteY="131dp" />

            <EditText
                android:id="@+id/emailtext"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:background="#F2F2F2"
                android:hint="@string/emaillabel"
                android:inputType="textEmailAddress"
                android:minHeight="40dp"
                android:padding="12dp"
                tools:layout_editor_absoluteX="38dp"

                tools:layout_editor_absoluteY="177dp" />

            <TextView
                android:id="@+id/password"
                android:layout_width="280dp"
                android:layout_height="0dp"
                android:text="@string/textpassword"
                android:textSize="20sp"
                tools:layout_editor_absoluteX="42dp"
                tools:layout_editor_absoluteY="369dp"

                />

            <EditText
                android:id="@+id/passwordregister"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:background="#F2F2F2"
                android:hint="@string/passwordlabel"
                android:inputType="textPassword"
                android:textSize="20sp"
                tools:layout_editor_absoluteX="42dp"
                tools:layout_editor_absoluteY="410dp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="280dp"
                android:layout_height="21dp"
                android:text="@string/confirmpasstext"
                android:textSize="20sp"
                android:labelFor="@+id/confirmpass"
                tools:layout_editor_absoluteX="42dp"
                tools:layout_editor_absoluteY="469dp" />

            <EditText
                android:id="@+id/confirmpass"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:autofillHints="..............."
                android:background="#F2F2F2"
                android:inputType="textPassword"
                tools:layout_editor_absoluteX="38dp"
                tools:layout_editor_absoluteY="505dp"

                />

            <Button
                android:id="@+id/createlink"
                android:layout_width="280dp"
                android:layout_height="53dp"
                android:backgroundTint="#0080FE"
                android:text="@string/createaccounttext"

                tools:layout_editor_absoluteX="24dp"
                tools:layout_editor_absoluteY="597dp" />

            <TextView
                android:id="@+id/signinlink"
                android:layout_width="280dp"
                android:layout_height="24dp"
                android:background="#F2F2F2"
                android:gravity="center"
                android:text="@string/logintextdirect"
                android:textSize="20sp"
                tools:layout_editor_absoluteX="24dp"
                tools:layout_editor_absoluteY="660dp" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
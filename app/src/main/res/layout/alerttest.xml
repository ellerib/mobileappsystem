<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="410dp"
        android:layout_height="170dp"
        android:background="#962EFF"
        >

        <Button
            android:layout_width="104dp"
            android:layout_height="37dp"
            android:background="#C48AFF"
            android:text="Switch"
            tools:layout_editor_absoluteX="307dp"
            tools:layout_editor_absoluteY="0dp" />

        <TextView
            android:layout_width="101dp"
            android:layout_height="26dp"
            android:text="Breeding Mode"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="2dp"
            tools:layout_editor_absoluteY="3dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="231dp"
        android:layout_height="36dp"
        android:text="Real-time Monitoring"
        android:textSize="16dp"
        tools:layout_editor_absoluteX="4dp"
        tools:layout_editor_absoluteY="177dp"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="404dp"
        android:layout_height="102dp"
        tools:layout_editor_absoluteX="4dp"
        tools:layout_editor_absoluteY="228dp">

        <TextView
            android:layout_width="109dp"
            android:layout_height="34dp"
            android:text="pH Level"
            android:textSize="15dp"
            android:drawableLeft="@drawable/baseline_water_drop_24"

        <ProgressBar
            android:id="@+id/phprogress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="407dp"
            android:layout_height="40dp"
            android:max="100"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="46dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="100dp"
            android:layout_height="30dp"
            tools:layout_editor_absoluteX="306dp"
            tools:layout_editor_absoluteY="4dp"
            android:text="UNSAFE"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>